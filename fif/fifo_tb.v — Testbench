`timescale 1ns/1ps

module fifo_tb;

reg clk;
reg reset;
reg wr_en;
reg rd_en;
reg [7:0] data_in;

wire [7:0] data_out;
wire full;
wire empty;

fifo uut (
    .clk(clk),
    .reset(reset),
    .wr_en(wr_en),
    .rd_en(rd_en),
    .data_in(data_in),
    .data_out(data_out),
    .full(full),
    .empty(empty)
);

// Clock generation
always #5 clk = ~clk;

initial begin

    $monitor("Time=%0t | Reset=%b | WR=%b | RD=%b | Data_in=%h | Data_out=%h | Full=%b | Empty=%b",
             $time, reset, wr_en, rd_en, data_in, data_out, full, empty);

    clk = 0;
    reset = 1;
    wr_en = 0;
    rd_en = 0;
    data_in = 0;

    #10;
    reset = 0;

    // Write data
    #10;
    wr_en = 1;
    data_in = 8'hA1;

    #10;
    data_in = 8'hB2;

    #10;
    data_in = 8'hC3;

    #10;
    data_in = 8'hD4;

    // Stop writing
    #10;
    wr_en = 0;

    // Read data
    #10;
    rd_en = 1;

    #10;
    #10;
    #10;

    // Stop reading
    #10;
    rd_en = 0;

    #10;
    $finish;

end

endmodule